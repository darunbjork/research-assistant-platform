{
  "__inputs": [],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Latency breakdown for every RAG pipeline stage",
  "editable": true,
  "panels": [

    {
      "id": 1,
      "title": "🔍 Full Pipeline Latency Heatmap",
      "description": "Every bucket shows how many requests completed within that time range.",
      "type": "heatmap",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "options": {
        "calculate":    false,
        "cellGap":      1,
        "color":        { "scheme": "Oranges", "steps": 128 },
        "yAxis":        { "unit": "s" }
      },
      "targets": [{
        "expr":         "sum(rate(retrieval_latency_seconds_bucket[5m])) by (le)",
        "legendFormat": "{{le}}",
        "datasource":   "Prometheus",
        "format":       "heatmap"
      }]
    },

    {
      "id": 2,
      "title": "📊 Latency Percentiles — All Stages",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "options": {
        "sortBy": [{ "displayName": "Stage", "desc": false }]
      },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr":         "histogram_quantile(0.50, rate(retrieval_latency_seconds_bucket[5m]))",
          "legendFormat": "Retrieval P50",
          "datasource":   "Prometheus"
        },
        {
          "expr":         "histogram_quantile(0.95, rate(retrieval_latency_seconds_bucket[5m]))",
          "legendFormat": "Retrieval P95",
          "datasource":   "Prometheus"
        },
        {
          "expr":         "histogram_quantile(0.50, rate(generation_latency_seconds_bucket[5m]))",
          "legendFormat": "Generation P50",
          "datasource":   "Prometheus"
        },
        {
          "expr":         "histogram_quantile(0.95, rate(generation_latency_seconds_bucket[5m]))",
          "legendFormat": "Generation P95",
          "datasource":   "Prometheus"
        },
        {
          "expr":         "histogram_quantile(0.50, rate(embedding_latency_seconds_bucket[5m]))",
          "legendFormat": "Embedding P50",
          "datasource":   "Prometheus"
        },
        {
          "expr":         "histogram_quantile(0.95, rate(embedding_latency_seconds_bucket[5m]))",
          "legendFormat": "Embedding P95",
          "datasource":   "Prometheus"
        },
        {
          "expr":         "histogram_quantile(0.50, rate(rerank_latency_seconds_bucket[5m]))",
          "legendFormat": "Reranking P50",
          "datasource":   "Prometheus"
        },
        {
          "expr":         "histogram_quantile(0.95, rate(rerank_latency_seconds_bucket[5m]))",
          "legendFormat": "Reranking P95",
          "datasource":   "Prometheus"
        }
      ]
    }

  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["rag", "latency"],
  "time": { "from": "now-30m", "to": "now" },
  "title": "Research Assistant — Latency Deep Dive",
  "uid": "rag-latency-v1",
  "version": 1
}