DOMAIN=research.example.com
NODE_ENV=production
PORT=3001
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=ragdb
DATABASE_URL=postgresql://rag:change-me-long-random@postgres:5432/ragdb?connection_limit=10
REDIS_URL=redis://redis:6379
GEMINI_API_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
# EXACT origins allowed for CORS and the WebSocket handshake: scheme + host
# + port, no trailing slash — every origin a browser actually uses to reach
# the app. The WS server closes any handshake whose Origin header is not
# listed (close 1008, reason "origin not allowed"); include the local
# rehearsal stack as https://localhost:8443 when using it. Checked by
# scripts/smoke.sh step 8.
CORS_ORIGINS=https://research.example.com
ALLOW_REGISTRATION=true
GLOBAL_DAILY_LLM_CALLS_MAX=2000
METRICS_TOKEN=
# Reverse proxies in front of the backend (1 = Caddy in compose, Traefik on k3s).
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
# Voice layer: both directions mock by default — enable a real provider ONLY
# after the spend-cap checklist in docs/cost.md is completed. Keys stay empty
# while mocking. VOICE_MOCK controls speech-to-text (Deepgram) only;
# TTS_PROVIDER (mock | elevenlabs) controls spoken answers.
VOICE_MOCK=true
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
TTS_PROVIDER=mock
TTS_MAX_CHARS=600
TTS_DAILY_CHARS_PER_USER=20000
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
