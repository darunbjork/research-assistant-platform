# Copy to .env and fill in. Every variable below is read via
# src/config/env.ts — startup fails fast (exit 1) if a required one is
# missing or invalid, naming the variable but never its value.

# ── Core ─────────────────────────────────────────────────────────────────────
# development | test | production (default: development)
NODE_ENV="development"
PORT=3001
LOG_LEVEL="info"

# ── Database ─────────────────────────────────────────────────────────────────
# In production, append ?connection_limit=10 so the single shared PrismaClient
# (src/utils/prisma.ts) cannot open more than 10 connections per instance:
# DATABASE_URL="postgresql://user:pass@host:5432/ragdb?connection_limit=10"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ragdb"
REDIS_URL="redis://localhost:6379"

# ── Gemini (required) ───────────────────────────────────────────────────────
# Required, minimum 20 characters.
GEMINI_API_KEY="your_gemini_api_key_here"
# Model used for generation/agent/evaluator/reranker (default: gemini-3.6-flash)
GEMINI_GENERATION_MODEL="gemini-3.6-flash"
# Embedding model (default: gemini-embedding-001). Must keep producing
# 768-dim vectors to match the vector(768) column — do not swap casually.
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# Per-request Gemini timeout in milliseconds (default: 30000)
GEMINI_TIMEOUT_MS=30000

# ── Auth (required) ─────────────────────────────────────────────────────────
# Both minimum 32 characters, and they must be different from each other.
JWT_SECRET="minimum_32_characters_change_this_now_seriously"
JWT_REFRESH_SECRET="a_different_32_char_secret_from_the_one_above"

# ── HTTP ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. REQUIRED in production
# (startup fails when NODE_ENV=production and this is empty). Leave unset in
# development — the Vite dev proxy makes dev same-origin, so CORS is unused.
# CORS_ORIGINS="https://research.example.com"
# true | false (default: true) — whether POST /auth/register accepts signups.
ALLOW_REGISTRATION=true

# ── Limits & observability ──────────────────────────────────────────────────
# Global cap on LLM calls per day across all users (default: 2000).
GLOBAL_DAILY_LLM_CALLS_MAX=2000
# When set (minimum 24 characters), GET /metrics requires
# "Authorization: Bearer <token>" and returns 404 otherwise. Unset = open
# (development default). Set it in production; Caddy also refuses to route
# /metrics (task 5.3).
# METRICS_TOKEN=""

# ── OpenTelemetry (fully optional — keep commented to disable) ───────────────
# Without an endpoint the SDK stays silent in production (no console spam);
# development and test keep the local console exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_SERVICE_NAME="research-assistant-backend"
# Sampler: always_on | traceidratio (with OTEL_TRACES_SAMPLER_ARG as rate)
# OTEL_TRACES_SAMPLER=always_on
# OTEL_TRACES_SAMPLER_ARG=1.0
# JAEGER_UI_URL="http://localhost:16686"
# SERVICE_VERSION="1.0.0"

# ── Not wired yet (no dependency in package.json) ───────────────────────────
# TAVILY_API_KEY="your_tavily_api_key_here"
# SENTRY_DSN=""
