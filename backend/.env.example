DATABASE_URL="postgresql://user:password@localhost:5432/ragdb"

REDIS_URL="redis://localhost:6379"

GEMINI_API_KEY="your_gemini_api_key_here"

TAVILY_API_KEY="your_tavily_api_key_here"

JWT_SECRET="minimum_32_characters_change_this_now_seriously"
JWT_REFRESH_SECRET="a_different_32_char_secret_from_the_one_above"

SENTRY_DSN=""

NODE_ENV="development"
PORT=3001
LOG_LEVEL="info"

# ── OpenTelemetry (optional — defaults to console exporter if not set) ───
# Uncomment to send traces to Jaeger:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=research-assistant-backend

# Uncomment to send traces to Grafana Tempo:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=research-assistant-backend

# Sampling rate (0.0 = no traces, 1.0 = all traces, 0.1 = 10% of traces)
# OTEL_TRACES_SAMPLER=always_on
# OTEL_TRACES_SAMPLER_ARG=1.0

# Jaeger UI URL (for trace links in API responses)
# JAEGER_UI_URL=http://localhost:16686

# Service version (shown in traces)
# SERVICE_VERSION=1.0.0