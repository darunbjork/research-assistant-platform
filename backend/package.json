{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "no-any": "grep -r 'any' src --include='*.ts' | grep -v '// eslint\\|node_modules\\|dist\\|.test.ts\\|mock' && echo '❌ Found any types' || echo '✅ Zero any types'",
    "monitoring:up": "docker compose -f docker-compose.monitoring.yml up -d",
    "monitoring:down": "docker compose -f docker-compose.monitoring.yml down",
    "monitoring:logs": "docker compose -f docker-compose.monitoring.yml logs -f",
    "loadtest:setup": "npx ts-node load-tests/scripts/setup-test-user.ts",
    "loadtest:baseline": "artillery run load-tests/scenarios/01-baseline.yml --output load-tests/reports/baseline.json",
    "loadtest:ramp": "artillery run load-tests/scenarios/02-ramp-up.yml --output load-tests/reports/ramp.json",
    "loadtest:cache": "artillery run load-tests/scenarios/03-cache-warming.yml --output load-tests/reports/cache.json",
    "loadtest:spike": "artillery run load-tests/scenarios/04-spike.yml --output load-tests/reports/spike.json",
    "loadtest:sustained": "artillery run load-tests/scenarios/05-sustained.yml --output load-tests/reports/sustained.json",
    "loadtest:ws": "artillery run load-tests/scenarios/06-websocket.yml --output load-tests/reports/websocket.json",
    "loadtest:analyze": "npx ts-node load-tests/scripts/analyze-results.ts",
    "loadtest:all": "npm run loadtest:baseline && npm run loadtest:ramp && npm run loadtest:cache && npm run loadtest:analyze load-tests/reports/ramp.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^3.15.9",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "artillery": "^2.0.21",
    "eslint": "^10.2.1",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
