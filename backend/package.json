{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
"scripts": {
  "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
  "build": "tsc",
  "start": "node dist/app.js",
  "type-check": "tsc --noEmit",
  "lint": "eslint 'src/**/*.ts' --max-warnings 0",
  "lint:fix": "eslint 'src/**/*.ts' --fix",
  "prettier": "prettier --write 'src/**/*.{ts,json}'",
  "prettier:check": "prettier --check 'src/**/*.{ts,json}'",
  "test": "jest --passWithNoTests",
  "test:coverage": "jest --coverage",
  "validate": "npm run type-check && npm run lint && npm run prettier:check",
  "no-any": "grep -r \": any\" src/ && echo '❌ FOUND any TYPES' && exit 1 || echo '✅ Zero any types'"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
