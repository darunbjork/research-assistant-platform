// backend/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  GUEST
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  documents    Document[]
  sessions     AgentSession[]

  @@map("users")
}

model Document {
  id        String          @id @default(cuid())
  name      String
  content   String
  mimeType  String
  sizeBytes Int
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@map("documents")
}

model DocumentChunk {
  id               String                  @id @default(cuid())
  documentId       String
  document         Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content          String
  chunkIndex       Int
  tokenCount       Int
  /// pgvector 768-dimensional embedding (Gemini text-embedding-004)
  embedding        Unsupported("vector(768)")?
  source           String
  pageNumber       Int?
  chunkingStrategy String
  createdAt        DateTime                @default(now())

  @@index([documentId])
  @@map("document_chunks")
}

model AgentSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query      String
  result     Json?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("agent_sessions")
}