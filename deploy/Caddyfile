# deploy/Caddyfile — used by both deployments:
#
#   compose (docker-compose.prod.yml): SITE_ADDRESS={$DOMAIN}. Caddy is the
#     public edge: it terminates TLS, proxies /api, /ws and /health to the
#     backend, and sends HSTS.
#   k3s (deploy/k8s): SITE_ADDRESS=:8080, HSTS=off. Traefik terminates TLS,
#     routes /api, /ws and /health straight to the backend Service, and sends
#     HSTS from its Middleware; this Caddy only serves the SPA (the proxy
#     handles below are never hit there). Port 8080 so it can run as non-root
#     without CAP_NET_BIND_SERVICE.
#
# Caddy substitutes {$VAR} before parsing, so `import hsts-{$HSTS}` picks a
# snippet. DOMAIN is still required in both modes: the CSP below names the
# WebSocket origin.

(hsts-on) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
(hsts-off) {
}

{$SITE_ADDRESS} {
    encode zstd gzip

    # API, WebSocket and health go to the backend. Caddy proxies WebSocket upgrades automatically.
    handle /api/* {
        reverse_proxy backend:3001
    }
    handle /ws/* {
        reverse_proxy backend:3001
    }
    handle /health {
        reverse_proxy backend:3001
    }
    # /metrics is intentionally NOT routed: reachable only on the internal Docker network.

    # Day 5: the AudioWorklet module has a FIXED name but is replaced on
    # every deploy — never let a browser treat it as immutable. no-cache
    # means revalidate (etag/last-modified) on every use.
    header /worklets/* Cache-Control "no-cache"

    # SPA: static files, fall back to index.html for client-side routes.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    import hsts-{$HSTS:on}

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        # worker-src is explicit: the AudioWorklet module is same-origin
        # (/worklets/*.js — Chrome gates worklet loads under script-src, so
        # a blob: URL would require script-src blob:). blob: stays disallowed.
        Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$DOMAIN}; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'"
        # Day 4: the mic is only ever granted to this origin; camera stays off.
        Permissions-Policy "microphone=(self), camera=()"
    }
}
