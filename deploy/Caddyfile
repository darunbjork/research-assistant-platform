{$DOMAIN} {
    encode zstd gzip

    # API, WebSocket and health go to the backend. Caddy proxies WebSocket upgrades automatically.
    handle /api/* {
        reverse_proxy backend:3001
    }
    handle /ws/* {
        reverse_proxy backend:3001
    }
    handle /health {
        reverse_proxy backend:3001
    }
    # /metrics is intentionally NOT routed: reachable only on the internal Docker network.

    # SPA: static files, fall back to index.html for client-side routes.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        # worker-src is explicit: the AudioWorklet module is same-origin
        # (/worklets/*.js — Chrome gates worklet loads under script-src, so
        # a blob: URL would require script-src blob:). blob: stays disallowed.
        Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$DOMAIN}; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'"
        # Day 4: the mic is only ever granted to this origin; camera stays off.
        Permissions-Policy "microphone=(self), camera=()"
    }
}
